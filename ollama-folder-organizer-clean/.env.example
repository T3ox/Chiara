OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=60

# Usato da docker-compose.yml per raggiungere Ollama installato sul computer host.
# Su Docker Desktop funziona cosi; su Linux compose usa anche extra_hosts host-gateway.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
